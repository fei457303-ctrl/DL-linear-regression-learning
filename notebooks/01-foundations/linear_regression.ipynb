    "assert torch.unique(torch.cat([train_idx, test_idx])).numel() == N\n",
    "assert torch.isfinite(X).all() and torch.isfinite(y).all()\n",
    "print('训练集维度：', tuple(X_train.shape), tuple(y_train.shape))\n",
