    "model = nn.Linear(D, 1)\n",
    "with torch.no_grad():\n",
    "    model.weight.zero_()\n",
    "    model.bias.zero_()\n",
    "criterion = nn.MSELoss()\n",
    "optimizer = torch.optim.SGD(model.parameters(), lr=LR)\n",
    "loader = DataLoader(TensorDataset(X_train, y_train), batch_size=BATCH_SIZE,\n",
    "                    shuffle=True, num_workers=0,\n",
    "                    generator=torch.Generator().manual_seed(BATCH_SEED))\n",
    "\n",
    "with torch.no_grad():\n",
    "    history = [criterion(model(X_train), y_train).item()]\n",
    "for epoch in range(1, EPOCHS + 1):\n",
    "    model.train()\n",
    "    for xb, yb in loader:\n",
    "        optimizer.zero_grad(set_to_none=True)\n",
    "        prediction = model(xb)\n",
    "        assert prediction.shape == yb.shape\n",
    "        loss = criterion(prediction, yb) / 2\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "    model.eval()\n",
    "    with torch.no_grad():\n",
    "        history.append(criterion(model(X_train), y_train).item())\n",
    "    if epoch in (1, 5, 10, EPOCHS):\n",
    "        print(f'第 {epoch:2d} 轮：训练 MSE = {history[-1]:.8f}')\n",
    "\n",
    "assert np.isfinite(history).all() and history[-1] < history[0]\n",
    "print('每轮更新次数：', len(loader), '| 总更新次数：', EPOCHS * len(loader))"
   ]
